{
  "name": "gc-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3344",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "arch": "depcruise src --config .dependency-cruiser.cjs --output-type err",
    "test": "jest --watch",
    "test:ci": "jest --ci",
    "test:coverage": "jest --coverage --ci",
    "mutation": "stryker run",
    "test:pre-commit": "jest --bail --passWithNoTests",
    "prepare": "husky",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,json,md}\"",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run knip && npm run arch && npm run db:check && npm run test:ci && npm run mutation",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:enroll": "tsx --env-file-if-exists=.env scripts/auth-enroll.ts",
    "knip": "knip",
    "db:check": "node scripts/check-drizzle-drift.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.28",
    "@better-auth/passkey": "^1.7.28",
    "@libsql/client": "^0.18.0",
    "better-auth": "^1.7.28",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/jest-runner": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^18.9.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jest": "^29.17.2",
    "eslint-plugin-security": "^4.2.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "knip": "^6.48.0",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.74.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "type": "module"
}
